{
    "name": "aegisora/any-of-rule-guardian",
    "description": "<REPOSITORY_DESCRIPTION>",
    "type": "library",
    "keywords": ["php", "aegisora", "aegisora-ecosystem"],
    "homepage": "https://github.com/Aegisora/any-of-rule-guardian",
    "support": {
        "issues": "https://github.com/Aegisora/any-of-rule-guardian/issues",
        "source": "https://github.com/Aegisora/any-of-rule-guardian"
    },
    "authors": [
        {
            "name": "Arslan Imamutdinov",
            "email": "ara.imamutdinov@gmail.com",
            "role": "Developer"
        }
    ],
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "aegisora/any-of-rule": "^1.0",
        "aegisora/guardian": "^1.0",
        "aegisora/rule-contract": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Aegisora\\RuleGuardians\\AnyOfRule\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aegisora\\RuleGuardians\\AnyOfRule\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "archive": {
        "exclude": [
            "/.github",
            "/tests",
            "/vendor",
            "/.gitignore",
            "/badge.svg",
            "/clover.xml",
            "/composer.lock",
            "/CONTRIBUTING.md",
            "/docker-compose.yml",
            "/Dockerfile",
            "/docker-compose-up.sh",
            "/docker-compose-down.sh",
            "/docker-deploy.sh",
            "/docker-run-checks.sh",
            "/docker-run-phpcs.sh",
            "/docker-run-phpstan.sh",
            "/docker-run-unit-tests.sh",
            "/phpcs.xml",
            "/phpstan.neon.dist",
            "/phpunit.xml"
        ]
    }
}
